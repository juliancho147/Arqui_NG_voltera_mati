# Apicurio Registry 3.x, almacenamiento en MEMORIA (H2 en memoria, por defecto): lo más liviano para un
# entorno efímero. Los esquemas se pierden al reiniciar el pod; se vuelven a registrar desde mesh/asyncapi.yaml.
# (No se usa Helm: Apicurio no publica un chart oficial simple; un Deployment + Service es lo más directo.)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: apicurio-registry
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: apicurio-registry
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: apicurio-registry
  template:
    metadata:
      labels:
        app.kubernetes.io/name: apicurio-registry
    spec:
      containers:
        - name: registry
          image: ${image}
          ports:
            - name: http
              containerPort: 8080
          env:
            # Container Insights inyecta OTEL_PROPAGATORS=xray, que Apicurio (Quarkus) no reconoce y no arranca.
            - name: QUARKUS_OTEL_SDK_DISABLED
              value: "true"
            - name: OTEL_PROPAGATORS
              value: "tracecontext"
            - name: JAVA_OPTS_APPEND
              value: "-Xms128m -Xmx384m"
            - name: APICURIO_STORAGE_KIND
              value: sql
            - name: APICURIO_STORAGE_SQL_KIND
              value: h2
          readinessProbe:
            httpGet:
              path: /apis/registry/v3/system/info
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 45
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
            limits:
              memory: 768Mi
---
apiVersion: v1
kind: Service
metadata:
  name: apicurio-registry
  namespace: ${namespace}
spec:
  selector:
    app.kubernetes.io/name: apicurio-registry
  ports:
    - name: http
      port: 8080
      targetPort: http
