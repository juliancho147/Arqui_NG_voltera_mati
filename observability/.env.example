# Copiar a .env (ignorado por git). NO poner claves AWS aqui: van en aws/credentials.
GRAFANA_VERSION=11.4.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave

AWS_REGION=us-east-1
AWS_PROFILE=voltera-grafana
# Archivo con SOLO el perfil [voltera-grafana] (ver README). Por defecto ./aws/credentials
AWS_CREDENTIALS_FILE=./aws/credentials

# Los prefijos de recursos (voltera-exp2, voltera-exp2-eph) estan fijados en los dashboards;
# para cambiarlos: python3 tools/gen_dashboards.py --prefix X --cluster Y
