    {
      "id": 6,
      "type": "table",
      "title": "Tiempo del lote por cicloId (inicio de ciclo -> ultima factura procesada)",
      "description": "Compara 'segundos' con el SLA (variable slaSeg = 120). Las filas incluyen rechazos de negocio con la linea 'factura procesada'.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields toMillis(@timestamp) as t\n| filter cicloId like /$cicloId/ and (message = \"ciclo iniciado\" or message = \"factura procesada\")\n| stats min(t) as ini, max(t) as fin, count(*) as eventos by cicloId\n| fields cicloId, (fin - ini) / 1000 as segundos, eventos\n| sort segundos desc",
          "logGroupNames": [
            "/aws/lambda/voltera-exp2-ms-orchestrator-billing",
            "/aws/lambda/voltera-exp2-ms-facturacion"
          ],
          "logGroups": [],
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
