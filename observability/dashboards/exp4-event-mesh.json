    {
      "id": 4,
      "type": "table",
      "title": "Eventos publicados al mesh por factura (completitud)",
      "description": "Log 'evento publicado' (tipo, cicloId, facturaId, eventId) del publisher. Una factura completa aprobada publica TarifaValidada, CargoEnergeticoCalculado, FacturaEmitida, NotificacionRegistrada y FacturaNotificada. Filas con pocos tipos = eventos faltantes o rechazo de negocio.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter message = \"evento publicado\" and cicloId like /$cicloId/ and facturaId like /$facturaId/\n| stats count_distinct(tipo) as tipos_distintos, count(*) as publicaciones, min(@timestamp) as primera, max(@timestamp) as ultima by cicloId, facturaId\n| sort tipos_distintos asc, ultima desc\n| limit 200",
          "logGroupNames": [
            "/aws/lambda/voltera-exp2-ms-tarifas",
            "/aws/lambda/voltera-exp2-ms-calculo-consumo-neto",
            "/aws/lambda/voltera-exp2-ms-facturacion",
            "/aws/lambda/voltera-exp2-ms-comprobante-factura",
            "/aws/lambda/voltera-exp2-ms-orchestrator-billing"
          ],
          "logGroups": [],
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
