      "type": "table",
      "title": "Fallos de publicacion detectados por log ('fallo publicando')",
      "description": "Detalle: el publisher registra el error en un log JSON ('fallo publicando evento al mesh').",
      "datasource": {
        "type": "cloudwatch",
