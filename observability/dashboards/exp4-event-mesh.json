        },
        "options": [
          {
            "selected": true,
            "text": ".",
            "value": "."
          }
        ],
        "description": "Regex sobre cicloId para Logs Insights; '.' = todos los ciclos. Las metricas EMF no llevan cicloId (dimension no disponible).",
        "hide": 0
