      {
        "type": "query",
        "name": "sfn",
        "label": "State machine",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensionKey": "StateMachineArn",
          "dimensionFilters": {},
          "refId": "VarSfn"
        },
        "regex": "/.*voltera-exp2-facturacion$/",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "type": "textbox",
        "name": "facturaId",
        "label": "facturaId",
        "query": ".",
