          },
          "refId": "A",
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, type, execution_arn\n| filter type in [\"ExecutionStarted\",\"ExecutionSucceeded\",\"ExecutionFailed\",\"ExecutionTimedOut\"] and @message like /$cicloId/\n| sort @timestamp desc\n| limit 100",
